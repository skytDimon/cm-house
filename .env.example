# Порт для сервера (при запуске в Docker)
PORT=8080

# Почта для получения заявок (по умолчанию cmhouse2005@mail.ru)
VITE_NOTIFICATION_EMAIL=cmhouse2005@mail.ru

# Telegram-бот для уведомлений о заявках
# 1. Создайте бота в Telegram через @BotFather -> получите токен (напр. 123456789:ABCdefGhI...)
# 2. Узнайте свой chat_id через бота @userinfobot (или добавьте бота в группу и узнайте id группы)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Для серверной части (если используется backend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_EMAIL=cmhouse2005@mail.ru
